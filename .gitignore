# Backend
backend/venv/
backend/__pycache__/
backend/**/__pycache__/
backend/.env
backend/*.db
backend/app/models_data/*.onnx
backend/app/known_faces/*
!backend/app/known_faces/.gitkeep
backend/app/snapshots/*
!backend/app/snapshots/.gitkeep
backend/yolov8n.pt
backend/*.pt
# Frontend compilado que copia el Dockerfile acá adentro para que FastAPI lo
# sirva en el deploy de un solo servicio (Railway) -- es un artefacto de build,
# no código fuente.
backend/static_frontend/

# Lo que deja PyInstaller al compilar el agente a mano en tu Mac (ver
# "ahora la pregunta del millon mi mac es..."): ejecutables de cientos de MB,
# GitHub los rechaza (límite 100MB por archivo) y de cualquier forma esto
# siempre se recompila solo en el workflow de Actions -- nunca va al repo.
backend/dist/
backend/build/
*.pkg
*.spec

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/dev-dist/

# Sistema
.DS_Store
*.log

# Lo que deja PyInstaller al compilar el agente a mano en tu Mac: ejecutables
# de cientos de MB, GitHub los rechaza (límite 100MB) y de cualquier forma esto
# siempre se recompila solo en el workflow de Actions -- nunca va al repo.
backend/dist/
backend/build/
*.pkg
*.spec
