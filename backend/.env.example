# Copiá este archivo a ".env" y completá tus valores. NUNCA subas ".env" a git.

# Seguridad / JWT
SECRET_KEY=cambiame-por-una-clave-larga-y-random
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Base de datos (SQLite local por defecto, suficiente para desarrollo)
DATABASE_URL=sqlite:///./centinela.db

# Mercado Pago (modo prueba: usá credenciales de TEST de tu cuenta de MP)
# https://www.mercadopago.com.ar/developers/panel/app
MP_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MP_PLAN_PRICE_ARS=30000
MP_WEBHOOK_URL=http://localhost:8000/api/subscription/webhook

# Telegram (se puede configurar por usuario desde la app, esto es un fallback global opcional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Carpetas internas (no tocar salvo que sepas lo que hacés)
MODELS_DIR=app/models_data
FACES_DIR=app/known_faces
SNAPSHOTS_DIR=app/snapshots

# CORS - origen del frontend en dev
FRONTEND_ORIGIN=http://localhost:5173

# Reconocimiento facial: umbral de similitud (0 a 1) para considerar "familiar".
# Más bajo = reconoce más fácil pero más riesgo de confundir personas.
# Más alto = más estricto pero puede no reconocerte si la foto de referencia
# tiene otro ángulo/luz que la cámara en vivo. Por defecto 0.30.
FACE_MATCH_THRESHOLD=0.30
